{
  "name": "toolhub",
  "version": "1.0.0",
  "description": "A collection of useful development tools",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd toolhub-server && npm start",
    "client": "cd toolhub && npm run dev",
    "install-all": "npm install --legacy-peer-deps && cd toolhub-server && npm install --legacy-peer-deps && cd ../toolhub && npm install --legacy-peer-deps"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.5.3",
    "prettier-plugin-java": "^2.6.7"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "cropperjs": "^1.5.13",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "vue-cropper": "^0.6.5"
  }
}
